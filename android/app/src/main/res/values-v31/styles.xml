<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ inserts a system splash before the activity window. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_adaptive_icon</item>
        <!-- Several OEM builds replace transparent with their default white
             icon tile. An explicit color matching the screen removes that
             visible rectangle while preserving the standalone mark. -->
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
